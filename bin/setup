#!/usr/bin/env bash
# Install Ruby from .ruby-version with mise, then the gems. Safe to run again.
set -euo pipefail
IFS=$'\n\t'

if ! command -v mise >/dev/null; then
  echo "mise not found. Install it first: see docs/SETUP.md, \"10-minute setup\"." >&2
  exit 1
fi

# mise ignores .ruby-version until ruby is in idiomatic_version_file_enable_tools (default: []).
# This adds it to your global mise settings once; .ruby-version stays the only place Ruby is pinned.
if ! mise settings get idiomatic_version_file_enable_tools | grep -q '"ruby"'; then
  mise settings add idiomatic_version_file_enable_tools ruby
fi

# Pre-commit hook that blocks Evolving-Hockey and PuckPedia exports (ADR 0014).
git config core.hooksPath .githooks

set -vx
mise install
mise exec -- bundle install
